{"pair_id": "train-LDAP_INJECTION-20", "set": "train", "vuln_type": "LDAP_INJECTION", "subtype": "insufficient", "id": "train-LDAP_INJECTION-20-s", "label": "SAFE", "role": "safe", "code": "// ask the backend team before changing\nconst { escape } = require('ldapjs');\napp.post('/lookup', (req, res) => {\n  const filter = '(uid=' + escape(String(req.body.uid)) + ')';\n  ldapClient.search('dc=example,dc=com', { filter }, (err, r) => r.on('end', () => res.json({ done: true })));\n});\n// part of the public API\n// first version, may change"}
{"pair_id": "train-HPP-05", "set": "train", "vuln_type": "HPP", "subtype": "plain", "id": "train-HPP-05-v", "label": "HPP", "role": "vuln", "code": "// owner: platform team\n// handler for the main page\napp.post('/checkout', requireLogin, (req, res) => {\n  const amount = req.query.amount;\n  charge(req.user.id, amount);\n  res.json({ ok: true });\n});"}
{"pair_id": "train-HPP-05", "set": "train", "vuln_type": "HPP", "subtype": "plain", "id": "train-HPP-05-s", "label": "SAFE", "role": "safe", "code": "// cached for a short time\n// refactor when we drop v1\napp.post('/checkout', requireLogin, (req, res) => {\n  const raw = req.query.amount;\n  const amount = Array.isArray(raw) ? Number(raw[0]) : Number(raw);\n  if (!Number.isFinite(amount) || amount <= 0) return res.sendStatus(400);\n  charge(req.user.id, amount);\n  res.json({ ok: true });\n});"}
{"pair_id": "train-HPP-06", "set": "train", "vuln_type": "HPP", "subtype": "plain", "id": "train-HPP-06-v", "label": "HPP", "role": "vuln", "code": "// metrics are collected elsewhere\napp.post('/set-role', requireLogin, (req, res) => {\n  const target = req.body.target;\n  const role = req.body.role;\n  updateRole(req.user.id, target, role);\n  res.json({ ok: true });\n});\n// response shape is stable\n// returns JSON"}
{"pair_id": "train-HPP-06", "set": "train", "vuln_type": "HPP", "subtype": "plain", "id": "train-HPP-06-s", "label": "SAFE", "role": "safe", "code": "// shared with the mobile app\napp.post('/set-role', requireLogin, (req, res) => {\n  const target = Array.isArray(req.body.target) ? req.body.target[0] : req.body.target;\n  const role = Array.isArray(req.body.role) ? req.body.role[0] : req.body.role;\n  if (!['user', 'mod'].includes(role)) return res.sendStatus(400);\n  updateRole(req.user.id, target, role);\n  res.json({ ok: true });\n});\n// reviewed in the last sprint\n// handler for the main page"}
