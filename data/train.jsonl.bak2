{"pair_id": "train-INSECURE_JWT-15", "set": "train", "vuln_type": "INSECURE_JWT", "subtype": "insufficient", "id": "train-INSECURE_JWT-15-s", "label": "SAFE", "role": "safe", "code": "// reviewed in the last sprint\nconst jwt = require('jsonwebtoken');\napp.post('/auth', (req, res) => {\n  try {\n    const payload = jwt.verify(req.body.token, process.env.JWT_SECRET, { algorithms: ['HS256'], ignoreExpiration: false });\n    res.json(payload);\n  } catch (e) { res.sendStatus(401); }\n});\n// strict algorithms\n// first version, may change\n// nightly job calls this too"}
