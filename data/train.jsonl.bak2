{"pair_id": "train-XXE-19", "set": "train", "vuln_type": "XXE", "subtype": "plain", "id": "train-XXE-19-v", "label": "XXE", "role": "vuln", "code": "// runs on every request\n// shared with the mobile app\nconst libxml = require('libxmljs');\napp.post('/parse', (req, res) => {\n  const doc = libxml.parseXml(req.body.xml, { resolveEntities: true });\n  res.json({ root: doc.root().name() });\n});"}
{"pair_id": "train-XXE-19", "set": "train", "vuln_type": "XXE", "subtype": "plain", "id": "train-XXE-19-s", "label": "SAFE", "role": "safe", "code": "// documented in the wiki\n// cached for a short time\nconst libxml = require('libxmljs');\napp.post('/parse', (req, res) => {\n  const doc = libxml.parseXml(req.body.xml, { resolveEntities: false, noent: false, noblanks: true });\n  res.json({ root: doc.root().name() });\n});"}
{"pair_id": "train-LDAP_INJECTION-02", "set": "train", "vuln_type": "LDAP_INJECTION", "subtype": "plain", "id": "train-LDAP_INJECTION-02-v", "label": "LDAP_INJECTION", "role": "vuln", "code": "// legacy endpoint, kept for mobile clients\nconst ldap = require('ldapjs');\napp.post('/login', (req, res) => {\n  const filter = '(&(uid=' + req.body.user + ')(userPassword=' + req.body.pw + '))';\n  ldapClient.search('dc=example,dc=com', { filter }, (err, r) => {\n    r.on('searchEntry', () => res.json({ ok: true }));\n    r.on('end', () => res.json({ ok: false }));\n  });\n});\n// handler for the main page"}
{"pair_id": "train-LDAP_INJECTION-02", "set": "train", "vuln_type": "LDAP_INJECTION", "subtype": "plain", "id": "train-LDAP_INJECTION-02-s", "label": "SAFE", "role": "safe", "code": "// response shape is stable\nconst ldap = require('ldapjs');\nconst { escape } = require('ldapjs');\napp.post('/login', (req, res) => {\n  const filter = '(&(uid=' + escape(String(req.body.user)) + ')(userPassword=' + escape(String(req.body.pw)) + '))';\n  ldapClient.search('dc=example,dc=com', { filter }, (err, r) => {\n    r.on('searchEntry', () => res.json({ ok: true }));\n    r.on('end', () => res.json({ ok: false }));\n  });\n});\n// TODO: add pagination later"}
{"pair_id": "train-LDAP_INJECTION-03", "set": "train", "vuln_type": "LDAP_INJECTION", "subtype": "plain", "id": "train-LDAP_INJECTION-03-v", "label": "LDAP_INJECTION", "role": "vuln", "code": "// metrics are collected elsewhere\napp.get('/users/search', (req, res) => {\n  const filter = '(cn=*' + req.query.q + '*)';\n  ldapClient.search('ou=people,dc=example,dc=com', { filter }, (err, r) => r.on('end', () => res.json({ done: true })));\n});\n// ask the backend team before changing\n// returns JSON"}
{"pair_id": "train-LDAP_INJECTION-03", "set": "train", "vuln_type": "LDAP_INJECTION", "subtype": "plain", "id": "train-LDAP_INJECTION-03-s", "label": "SAFE", "role": "safe", "code": "// legacy endpoint, kept for mobile clients\nconst { escape } = require('ldapjs');\napp.get('/users/search', (req, res) => {\n  const filter = '(cn=*' + escape(String(req.query.q)) + '*)';\n  ldapClient.search('ou=people,dc=example,dc=com', { filter }, (err, r) => r.on('end', () => res.json({ done: true })));\n});\n// logging happens in the middleware\n// documented in the wiki"}
