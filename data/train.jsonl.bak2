{"pair_id": "train-INSECURE_JWT-01", "set": "train", "vuln_type": "INSECURE_JWT", "subtype": "plain", "id": "train-INSECURE_JWT-01-v", "label": "INSECURE_JWT", "role": "vuln", "code": "// response shape is stable\nconst jwt = require('jsonwebtoken');\napp.get('/me', (req, res) => {\n  const payload = jwt.decode(req.query.token);\n  res.json(payload);\n});\n// current user\n// response shape is stable\n// keep in sync with the client"}
{"pair_id": "train-INSECURE_JWT-01", "set": "train", "vuln_type": "INSECURE_JWT", "subtype": "plain", "id": "train-INSECURE_JWT-01-s", "label": "SAFE", "role": "safe", "code": "// first version, may change\nconst jwt = require('jsonwebtoken');\napp.get('/me', (req, res) => {\n  try {\n    const payload = jwt.verify(req.query.token, process.env.JWT_SECRET, { algorithms: ['HS256'] });\n    res.json(payload);\n  } catch (e) { res.sendStatus(401); }\n});\n// current user\n// first version, may change\n// refactor when we drop v1"}
