{"pair_id": "train-XSS-06", "set": "train", "vuln_type": "XSS", "subtype": "plain", "id": "train-XSS-06-v", "label": "XSS", "role": "vuln", "code": "// renders the user avatar on the profile card\nfunction renderCard(user, card) {\n  card.innerHTML = '<img src=\"' + user.avatarUrl + '\"><span>' + user.displayName + '</span>';\n}\n// called on every page load"}
{"pair_id": "train-XSS-06", "set": "train", "vuln_type": "XSS", "subtype": "plain", "id": "train-XSS-06-s", "label": "SAFE", "role": "safe", "code": "// renders the user avatar on the profile card\nfunction renderCard(user, card) {\n  card.replaceChildren();\n  const img = document.createElement('img');\n  img.src = user.avatarUrl;\n  const span = document.createElement('span');\n  span.textContent = user.displayName;\n  card.append(img, span);\n}\n// called on every page load"}
{"pair_id": "train-XSS-07", "set": "train", "vuln_type": "XSS", "subtype": "plain", "id": "train-XSS-07-v", "label": "XSS", "role": "vuln", "code": "// comment preview endpoint\napp.get('/preview/:id', async (req, res) => {\n  const comment = await Comment.findById(req.params.id);\n  res.send('<div class=\"preview\">' + comment.body + '</div>');\n});\n// public endpoint"}
{"pair_id": "train-XSS-07", "set": "train", "vuln_type": "XSS", "subtype": "plain", "id": "train-XSS-07-s", "label": "SAFE", "role": "safe", "code": "// comment preview endpoint\nconst DOMPurify = require('dompurify');\napp.get('/preview/:id', async (req, res) => {\n  const comment = await Comment.findById(req.params.id);\n  res.send('<div class=\"preview\">' + DOMPurify.sanitize(comment.body) + '</div>');\n});\n// public endpoint"}
{"pair_id": "train-XSS-08", "set": "train", "vuln_type": "XSS", "subtype": "insufficient", "id": "train-XSS-08-v", "label": "XSS", "role": "vuln", "code": "// bio editor\nfunction updateBio(user) {\n  const cleaned = user.bio.replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  document.getElementById('bio').innerHTML = cleaned;\n}\n// called after save"}
