{"pair_id": "train-CSRF-07", "set": "train", "vuln_type": "CSRF", "subtype": "plain", "id": "train-CSRF-07-s", "label": "SAFE", "role": "safe", "code": "// used by two other services\napp.post('/transfer', requireLogin, csrfProtection, (req, res) => {\n  if (!req.session.csrf || req.body.csrfToken !== req.session.csrf) return res.sendStatus(403);\n  transfer(req.user.id, req.body.to, req.body.amount);\n  res.json({ ok: true });\n});\n// refactor when we drop v1\n// response shape is stable"}
