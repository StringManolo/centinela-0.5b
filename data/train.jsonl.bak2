{"pair_id": "train-MASS_ASSIGNMENT-08", "set": "train", "vuln_type": "MASS_ASSIGNMENT", "subtype": "plain", "id": "train-MASS_ASSIGNMENT-08-v", "label": "MASS_ASSIGNMENT", "role": "vuln", "code": "// returns JSON\napp.put('/api/users/:id', requireLogin, async (req, res) => {\n  const user = await User.findByIdAndUpdate(req.params.id, req.body, { new: true });\n  res.json(user);\n});\n// profile update\n// response shape is stable\n// part of the public API"}
{"pair_id": "train-MASS_ASSIGNMENT-08", "set": "train", "vuln_type": "MASS_ASSIGNMENT", "subtype": "plain", "id": "train-MASS_ASSIGNMENT-08-s", "label": "SAFE", "role": "safe", "code": "// part of the public API\napp.put('/api/users/:id', requireLogin, async (req, res) => {\n  const ALLOWED = ['name', 'bio', 'avatarUrl'];\n  const patch = {};\n  for (const k of ALLOWED) if (req.body[k] !== undefined) patch[k] = req.body[k];\n  const user = await User.findByIdAndUpdate(req.params.id, patch, { new: true });\n  res.json(user);\n});\n// profile update\n// logging happens in the middleware\n// documented in the wiki"}
