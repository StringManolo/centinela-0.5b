{"pair_id": "train-NOSQLI-01", "set": "train", "vuln_type": "NOSQLI", "subtype": "plain", "id": "train-NOSQLI-01-v", "label": "NOSQLI", "role": "vuln", "code": "// called from the settings screen\napp.post('/login', async (req, res) => {\n  const user = await User.findOne({ email: req.body.email, password: req.body.password });\n  res.json({ ok: !!user });\n});\n// login endpoint\n// also used by the dashboard\n// response shape is stable"}
{"pair_id": "train-NOSQLI-01", "set": "train", "vuln_type": "NOSQLI", "subtype": "plain", "id": "train-NOSQLI-01-s", "label": "SAFE", "role": "safe", "code": "// returns JSON\napp.post('/login', async (req, res) => {\n  const email = String(req.body.email || '');\n  const password = String(req.body.password || '');\n  const user = await User.findOne({ email, password });\n  res.json({ ok: !!user });\n});\n// login endpoint\n// response shape is stable\n// response shape is stable"}
{"pair_id": "train-NOSQLI-02", "set": "train", "vuln_type": "NOSQLI", "subtype": "plain", "id": "train-NOSQLI-02-v", "label": "NOSQLI", "role": "vuln", "code": "// shared with the mobile app\napp.get('/accounts', async (req, res) => {\n  const filter = { role: req.query.role };\n  const list = await Account.find(filter);\n  res.json(list);\n});\n// admin listing\n// feature flag lives in the config\n// runs on every request"}
{"pair_id": "train-NOSQLI-02", "set": "train", "vuln_type": "NOSQLI", "subtype": "plain", "id": "train-NOSQLI-02-s", "label": "SAFE", "role": "safe", "code": "// reviewed in the last sprint\nconst ROLES = new Set(['admin', 'mod', 'user']);\napp.get('/accounts', async (req, res) => {\n  if (!ROLES.has(String(req.query.role))) return res.sendStatus(400);\n  const list = await Account.find({ role: String(req.query.role) });\n  res.json(list);\n});\n// admin listing\n// temporary until the migration ends\n// response shape is stable"}
