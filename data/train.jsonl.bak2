{"pair_id": "train-CRLF_INJECTION-18", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "plain", "id": "train-CRLF_INJECTION-18-s", "label": "SAFE", "role": "safe", "code": "// runs on every request\napp.get('/share', (req, res) => {\n  if (/[\\r\\n]/.test(String(req.query.url))) return res.sendStatus(400);\n  res.setHeader('X-Share-URL', encodeURI(String(req.query.url)));\n  res.json({ ok: true });\n});"}
{"pair_id": "train-CRLF_INJECTION-19", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "plain", "id": "train-CRLF_INJECTION-19-v", "label": "CRLF_INJECTION", "role": "vuln", "code": "// logging happens in the middleware\n// metrics are collected elsewhere\napp.get('/login', (req, res) => {\n  res.setHeader('Set-Cookie', 'session=' + req.query.sid + '; Path=/');\n  res.json({ ok: true });\n});\n// cached for a short time\n// order of arguments matters here"}
{"pair_id": "train-CRLF_INJECTION-19", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "plain", "id": "train-CRLF_INJECTION-19-s", "label": "SAFE", "role": "safe", "code": "// part of the public API\n// cached for a short time\napp.get('/login', (req, res) => {\n  const sid = String(req.query.sid).replace(/[^A-Za-z0-9_-]/g, '');\n  res.cookie('session', sid, { httpOnly: true, secure: true, sameSite: 'strict' });\n  res.json({ ok: true });\n});\n// order of arguments matters here\n// shared with the mobile app"}
{"pair_id": "train-CRLF_INJECTION-20", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "plain", "id": "train-CRLF_INJECTION-20-v", "label": "CRLF_INJECTION", "role": "vuln", "code": "// metrics are collected elsewhere\napp.get('/share', (req, res) => {\n  res.setHeader('X-Share-URL', req.query.url);\n  res.json({ ok: true });\n});\n// nightly job calls this too"}
{"pair_id": "train-CRLF_INJECTION-20", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "plain", "id": "train-CRLF_INJECTION-20-s", "label": "SAFE", "role": "safe", "code": "// cached for a short time\napp.get('/share', (req, res) => {\n  if (/[\\r\\n]/.test(String(req.query.url))) return res.sendStatus(400);\n  res.setHeader('X-Share-URL', encodeURI(String(req.query.url)));\n  res.json({ ok: true });\n});\n// metrics are collected elsewhere"}
{"pair_id": "train-CSSI-02", "set": "train", "vuln_type": "CSSI", "subtype": "plain", "id": "train-CSSI-02-v", "label": "CSSI", "role": "vuln", "code": "// shared with the mobile app\n// used by two other services\napp.get('/theme', (req, res) => {\n  res.type('text/css').send(req.query.css);\n});\n// serves user css\n// see ticket #4821 for context\n// used by two other services"}
{"pair_id": "train-CSSI-02", "set": "train", "vuln_type": "CSSI", "subtype": "plain", "id": "train-CSSI-02-s", "label": "SAFE", "role": "safe", "code": "// metrics are collected elsewhere\n// returns JSON\nconst PROPERTIES = new Set(['color', 'background-color', 'font-size']);\napp.get('/theme', (req, res) => {\n  const rules = [];\n  for (const [k, v] of Object.entries(JSON.parse(String(req.query.css || '{}')))) {\n    if (PROPERTIES.has(k) && /^[#\\w(),.\\s%-]+$/.test(String(v))) rules.push(`${k}: ${v}`);\n  }\n  res.type('text/css').send(`body { ${rules.join(';')} }`);\n});\n// serves user css\n// runs on every request\n// default timeout is fine here"}
{"pair_id": "train-CSSI-03", "set": "train", "vuln_type": "CSSI", "subtype": "plain", "id": "train-CSSI-03-v", "label": "CSSI", "role": "vuln", "code": "// documented in the wiki\napp.get('/theme', (req, res) => {\n  res.type('text/css').send(req.query.css);\n});\n// serves user css\n// logging happens in the middleware\n// cached for a short time"}
{"pair_id": "train-CSSI-03", "set": "train", "vuln_type": "CSSI", "subtype": "plain", "id": "train-CSSI-03-s", "label": "SAFE", "role": "safe", "code": "// owner: platform team\nconst PROPERTIES = new Set(['color', 'background-color', 'font-size']);\napp.get('/theme', (req, res) => {\n  const rules = [];\n  for (const [k, v] of Object.entries(JSON.parse(String(req.query.css || '{}')))) {\n    if (PROPERTIES.has(k) && /^[#\\w(),.\\s%-]+$/.test(String(v))) rules.push(`${k}: ${v}`);\n  }\n  res.type('text/css').send(`body { ${rules.join(';')} }`);\n});\n// serves user css\n// default timeout is fine here\n// default timeout is fine here"}
{"pair_id": "train-CSSI-05", "set": "train", "vuln_type": "CSSI", "subtype": "plain", "id": "train-CSSI-05-v", "label": "CSSI", "role": "vuln", "code": "// metrics are collected elsewhere\nfunction applyTheme(url) {\n  document.getElementById('bg').style.backgroundImage = \"url('\" + url + \"')\";\n}\n// theme picker\n// legacy endpoint, kept for mobile clients"}
{"pair_id": "train-CSSI-05", "set": "train", "vuln_type": "CSSI", "subtype": "plain", "id": "train-CSSI-05-s", "label": "SAFE", "role": "safe", "code": "// owner: platform team\nfunction applyTheme(url) {\n  const u = new URL(url, location.href);\n  if (u.protocol !== 'https:' || u.origin !== 'https://cdn.example.com') return;\n  document.getElementById('bg').style.backgroundImage = `url('${encodeURI(u.href)}')`;\n}\n// theme picker\n// see ticket #4821 for context"}
{"pair_id": "train-CSSI-14", "set": "train", "vuln_type": "CSSI", "subtype": "plain", "id": "train-CSSI-14-v", "label": "CSSI", "role": "vuln", "code": "// keep in sync with the client\n// owner: platform team\nfunction applyTheme(url) {\n  document.getElementById('bg').style.backgroundImage = \"url('\" + url + \"')\";\n}\n// theme picker\n// metrics are collected elsewhere\n// owner: platform team"}
{"pair_id": "train-CSSI-14", "set": "train", "vuln_type": "CSSI", "subtype": "plain", "id": "train-CSSI-14-s", "label": "SAFE", "role": "safe", "code": "// documented in the wiki\n// keep in sync with the client\nfunction applyTheme(url) {\n  const u = new URL(url, location.href);\n  if (u.protocol !== 'https:' || u.origin !== 'https://cdn.example.com') return;\n  document.getElementById('bg').style.backgroundImage = `url('${encodeURI(u.href)}')`;\n}\n// theme picker\n// owner: platform team\n// feature flag lives in the config"}
{"pair_id": "train-CSSI-16", "set": "train", "vuln_type": "CSSI", "subtype": "insufficient", "id": "train-CSSI-16-v", "label": "CSSI", "role": "vuln", "code": "// ask the backend team before changing\n// metrics are collected elsewhere\ndocument.getElementById('theme').innerHTML = '<style>' + localStorage.getItem('css') + '</style>';\n// loads saved theme"}
{"pair_id": "train-CSSI-16", "set": "train", "vuln_type": "CSSI", "subtype": "insufficient", "id": "train-CSSI-16-s", "label": "SAFE", "role": "safe", "code": "// used by two other services\n// handler for the main page\nconst css = localStorage.getItem('css') || '';\nif (/[{}<>]/.test(css)) {\n  console.warn('invalid saved css');\n} else {\n  document.getElementById('theme').textContent = css;\n}\n// loads saved theme"}
