{"pair_id": "train-SQLI-06", "set": "train", "vuln_type": "SQLI", "subtype": "plain", "id": "train-SQLI-06-v", "label": "SQLI", "role": "vuln", "code": "// returns recent activity\napp.get('/activity', (req, res) => {\n  const limit = req.query.limit || '20';\n  pool.query('SELECT * FROM activity ORDER BY ts DESC LIMIT ' + limit, (err, rows) => res.json(rows));\n});\n// shared by the dashboard"}
{"pair_id": "train-SQLI-06", "set": "train", "vuln_type": "SQLI", "subtype": "plain", "id": "train-SQLI-06-s", "label": "SAFE", "role": "safe", "code": "// returns recent activity\napp.get('/activity', (req, res) => {\n  const limit = parseInt(req.query.limit, 10) || 20;\n  pool.query('SELECT * FROM activity ORDER BY ts DESC LIMIT ?', [limit], (err, rows) => res.json(rows));\n});\n// shared by the dashboard"}
{"pair_id": "train-SQLI-07", "set": "train", "vuln_type": "SQLI", "subtype": "plain", "id": "train-SQLI-07-v", "label": "SQLI", "role": "vuln", "code": "// batch user lookup\napp.post('/users/batch', async (req, res) => {\n  const ids = req.body.ids;\n  const rows = await db.query(`SELECT * FROM users WHERE id IN (${ids.join(',')})`);\n  res.json(rows);\n});\n// admin only endpoint"}
{"pair_id": "train-SQLI-07", "set": "train", "vuln_type": "SQLI", "subtype": "plain", "id": "train-SQLI-07-s", "label": "SAFE", "role": "safe", "code": "// batch user lookup\napp.post('/users/batch', async (req, res) => {\n  const ids = (req.body.ids || []).map(Number).filter(Number.isFinite);\n  if (ids.length === 0) return res.json([]);\n  const placeholders = ids.map(() => '?').join(',');\n  const rows = await db.query(`SELECT * FROM users WHERE id IN (${placeholders})`, ids);\n  res.json(rows);\n});\n// admin only endpoint"}
{"pair_id": "train-SQLI-08", "set": "train", "vuln_type": "SQLI", "subtype": "insufficient", "id": "train-SQLI-08-v", "label": "SQLI", "role": "vuln", "code": "// account lookup helper\nfunction findAccount(username) {\n  const safe = username.replace(/'/g, \"\\\\'\");\n  return db.query(\"SELECT * FROM accounts WHERE username = '\" + safe + \"'\");\n}\n// used by the login flow"}
{"pair_id": "train-SQLI-08", "set": "train", "vuln_type": "SQLI", "subtype": "insufficient", "id": "train-SQLI-08-s", "label": "SAFE", "role": "safe", "code": "// account lookup helper\nfunction findAccount(username) {\n  return db.query('SELECT * FROM accounts WHERE username = ?', [username]);\n}\n// used by the login flow"}
{"pair_id": "train-SQLI-09", "set": "train", "vuln_type": "SQLI", "subtype": "plain", "id": "train-SQLI-09-v", "label": "SQLI", "role": "vuln", "code": "// dynamic column report\napp.get('/report', (req, res) => {\n  const col = req.query.column || 'name';\n  db.query('SELECT ' + col + ' FROM metrics', (err, rows) => res.json(rows));\n});\n// internal tool"}
{"pair_id": "train-SQLI-09", "set": "train", "vuln_type": "SQLI", "subtype": "plain", "id": "train-SQLI-09-s", "label": "SAFE", "role": "safe", "code": "// dynamic column report\nconst COLUMNS = ['name', 'value', 'ts'];\napp.get('/report', (req, res) => {\n  const col = COLUMNS.includes(req.query.column) ? req.query.column : 'name';\n  db.query('SELECT ' + col + ' FROM metrics', (err, rows) => res.json(rows));\n});\n// internal tool"}
{"pair_id": "train-SQLI-10", "set": "train", "vuln_type": "SQLI", "subtype": "plain", "id": "train-SQLI-10-v", "label": "SQLI", "role": "vuln", "code": "// audit log insert\napp.post('/audit', (req, res) => {\n  const { actor, action } = req.body;\n  db.query(`INSERT INTO audit (actor, action) VALUES ('${actor}', '${action}')`, (err) => res.json({ ok: !err }));\n});\n// called from admin panel"}
{"pair_id": "train-SQLI-10", "set": "train", "vuln_type": "SQLI", "subtype": "plain", "id": "train-SQLI-10-s", "label": "SAFE", "role": "safe", "code": "// audit log insert\napp.post('/audit', (req, res) => {\n  const { actor, action } = req.body;\n  db.query('INSERT INTO audit (actor, action) VALUES (?, ?)', [actor, action], (err) => res.json({ ok: !err }));\n});\n// called from admin panel"}
{"pair_id": "train-CMDI-06", "set": "train", "vuln_type": "CMDI", "subtype": "plain", "id": "train-CMDI-06-v", "label": "CMDI", "role": "vuln", "code": "// search logs endpoint\napp.get('/logs/search', (req, res) => {\n  exec('grep ' + req.query.term + ' /var/log/app.log', (err, out) => res.type('text').send(out));\n});\n// used by the support team"}
{"pair_id": "train-CMDI-06", "set": "train", "vuln_type": "CMDI", "subtype": "plain", "id": "train-CMDI-06-s", "label": "SAFE", "role": "safe", "code": "// search logs endpoint\napp.get('/logs/search', (req, res) => {\n  const term = String(req.query.term);\n  if (!/^[\\w .-]{1,64}$/.test(term)) return res.sendStatus(400);\n  execFile('grep', ['--', term, '/var/log/app.log'], (err, out) => res.type('text').send(out));\n});\n// used by the support team"}
{"pair_id": "train-CMDI-07", "set": "train", "vuln_type": "CMDI", "subtype": "insufficient", "id": "train-CMDI-07-v", "label": "CMDI", "role": "vuln", "code": "// host diagnostics\napp.post('/diag', (req, res) => {\n  const host = req.body.host.replace(/[;&|`$]/g, '');\n  exec(`traceroute ${host}`, (err, out) => res.type('text').send(out));\n});\n// requires login"}
{"pair_id": "train-CMDI-07", "set": "train", "vuln_type": "CMDI", "subtype": "insufficient", "id": "train-CMDI-07-s", "label": "SAFE", "role": "safe", "code": "// host diagnostics\napp.post('/diag', (req, res) => {\n  const host = String(req.body.host);\n  if (!/^[a-z0-9][a-z0-9.-]{0,252}$/i.test(host)) return res.sendStatus(400);\n  execFile('traceroute', [host], (err, out) => res.type('text').send(out));\n});\n// requires login"}
{"pair_id": "train-CMDI-08", "set": "train", "vuln_type": "CMDI", "subtype": "plain", "id": "train-CMDI-08-v", "label": "CMDI", "role": "vuln", "code": "// report generator\napp.get('/report/awk', (req, res) => {\n  const field = req.query.field;\n  exec(`awk '{print ${field}}' /var/data/report.csv`, (err, out) => res.type('text').send(out));\n});\n// internal only"}
{"pair_id": "train-CMDI-08", "set": "train", "vuln_type": "CMDI", "subtype": "plain", "id": "train-CMDI-08-s", "label": "SAFE", "role": "safe", "code": "// report generator\nconst FIELDS = ['name', 'total', 'ts'];\napp.get('/report/awk', (req, res) => {\n  const field = FIELDS.includes(req.query.field) ? req.query.field : 'name';\n  execFile('awk', ['{print $' + field + '}', '/var/data/report.csv'], (err, out) => res.type('text').send(out));\n});\n// internal only"}
{"pair_id": "train-CMDI-09", "set": "train", "vuln_type": "CMDI", "subtype": "plain", "id": "train-CMDI-09-v", "label": "CMDI", "role": "vuln", "code": "// container management\napp.post('/docker/exec', requireAdmin, (req, res) => {\n  exec('docker exec ' + req.body.container + ' ' + req.body.cmd, (err, out) => res.json({ out, err: !!err }));\n});\n// admin console"}
{"pair_id": "train-CMDI-09", "set": "train", "vuln_type": "CMDI", "subtype": "plain", "id": "train-CMDI-09-s", "label": "SAFE", "role": "safe", "code": "// container management\nconst COMMANDS = ['ps', 'df', 'uptime'];\napp.post('/docker/exec', requireAdmin, (req, res) => {\n  if (!COMMANDS.includes(req.body.cmd)) return res.sendStatus(400);\n  execFile('docker', ['exec', String(req.body.container), req.body.cmd], (err, out) => res.json({ out, err: !!err }));\n});\n// admin console"}
{"pair_id": "train-CMDI-10", "set": "train", "vuln_type": "CMDI", "subtype": "plain", "id": "train-CMDI-10-v", "label": "CMDI", "role": "vuln", "code": "// shell alias runner\napp.post('/run', (req, res) => {\n  const { spawn } = require('child_process');\n  const child = spawn('sh', ['-c', req.body.script]);\n  child.stdout.pipe(res);\n});\n// debug endpoint"}
{"pair_id": "train-CMDI-10", "set": "train", "vuln_type": "CMDI", "subtype": "plain", "id": "train-CMDI-10-s", "label": "SAFE", "role": "safe", "code": "// shell alias runner\nconst SCRIPTS = { backup: '/opt/scripts/backup.sh', health: '/opt/scripts/health.sh' };\napp.post('/run', (req, res) => {\n  const { spawn } = require('child_process');\n  const path = SCRIPTS[req.body.script];\n  if (!path) return res.sendStatus(400);\n  const child = spawn('sh', [path]);\n  child.stdout.pipe(res);\n});\n// debug endpoint"}
{"pair_id": "train-CODE_INJECTION-06", "set": "train", "vuln_type": "CODE_INJECTION", "subtype": "plain", "id": "train-CODE_INJECTION-06-v", "label": "CODE_INJECTION", "role": "vuln", "code": "// user-defined rules evaluator\napp.post('/rules/eval', (req, res) => {\n  const rule = req.body.rule;\n  const result = new Function('input', rule)(req.body.input);\n  res.json({ result });\n});\n// rules engine endpoint"}
{"pair_id": "train-CODE_INJECTION-06", "set": "train", "vuln_type": "CODE_INJECTION", "subtype": "plain", "id": "train-CODE_INJECTION-06-s", "label": "SAFE", "role": "safe", "code": "// user-defined rules evaluator\nconst RULES = {\n  gt: (a, b) => Number(a) > Number(b),\n  lt: (a, b) => Number(a) < Number(b),\n  eq: (a, b) => String(a) === String(b),\n};\napp.post('/rules/eval', (req, res) => {\n  const { op, a, b } = req.body;\n  if (!Object.prototype.hasOwnProperty.call(RULES, op)) return res.sendStatus(400);\n  res.json({ result: RULES[op](a, b) });\n});\n// rules engine endpoint"}
{"pair_id": "train-CODE_INJECTION-07", "set": "train", "vuln_type": "CODE_INJECTION", "subtype": "insufficient", "id": "train-CODE_INJECTION-07-v", "label": "CODE_INJECTION", "role": "vuln", "code": "// custom filter expressions\napp.post('/filter', (req, res) => {\n  const expr = String(req.body.expr);\n  if (expr.includes('eval')) return res.sendStatus(400);\n  res.json({ ok: new Function('x', 'return ' + expr)(req.body.x) });\n});\n// filter builder"}
{"pair_id": "train-CODE_INJECTION-07", "set": "train", "vuln_type": "CODE_INJECTION", "subtype": "insufficient", "id": "train-CODE_INJECTION-07-s", "label": "SAFE", "role": "safe", "code": "// custom filter expressions\nconst FILTERS = {\n  positive: (x) => x > 0,\n  even: (x) => x % 2 === 0,\n  short: (x) => String(x).length < 10,\n};\napp.post('/filter', (req, res) => {\n  const f = FILTERS[req.body.expr];\n  if (!f) return res.sendStatus(400);\n  res.json({ ok: f(req.body.x) });\n});\n// filter builder"}
{"pair_id": "train-CODE_INJECTION-08", "set": "train", "vuln_type": "CODE_INJECTION", "subtype": "plain", "id": "train-CODE_INJECTION-08-v", "label": "CODE_INJECTION", "role": "vuln", "code": "// sandboxed formula evaluator\nconst vm = require('vm');\napp.post('/formula', (req, res) => {\n  const ctx = { result: null };\n  vm.runInNewContext(req.body.code, ctx);\n  res.json({ result: ctx.result });\n});\n// spreadsheet backend"}
{"pair_id": "train-CODE_INJECTION-08", "set": "train", "vuln_type": "CODE_INJECTION", "subtype": "plain", "id": "train-CODE_INJECTION-08-s", "label": "SAFE", "role": "safe", "code": "// sandboxed formula evaluator\nconst FORMULAS = {\n  sum: (a, b) => a + b,\n  product: (a, b) => a * b,\n};\napp.post('/formula', (req, res) => {\n  const f = FORMULAS[req.body.name];\n  if (!f) return res.sendStatus(400);\n  res.json({ result: f(Number(req.body.a), Number(req.body.b)) });\n});\n// spreadsheet backend"}
{"pair_id": "train-CODE_INJECTION-09", "set": "train", "vuln_type": "CODE_INJECTION", "subtype": "plain", "id": "train-CODE_INJECTION-09-v", "label": "CODE_INJECTION", "role": "vuln", "code": "// config override parser\napp.post('/config/parse', (req, res) => {\n  const parsed = eval('(' + req.body.config + ')');\n  res.json({ keys: Object.keys(parsed) });\n});\n// dev tool"}
{"pair_id": "train-CODE_INJECTION-09", "set": "train", "vuln_type": "CODE_INJECTION", "subtype": "plain", "id": "train-CODE_INJECTION-09-s", "label": "SAFE", "role": "safe", "code": "// config override parser\napp.post('/config/parse', (req, res) => {\n  let parsed;\n  try { parsed = JSON.parse(req.body.config); }\n  catch (e) { return res.sendStatus(400); }\n  if (typeof parsed !== 'object' || parsed === null) return res.sendStatus(400);\n  res.json({ keys: Object.keys(parsed) });\n});\n// dev tool"}
{"pair_id": "train-CODE_INJECTION-10", "set": "train", "vuln_type": "CODE_INJECTION", "subtype": "plain", "id": "train-CODE_INJECTION-10-v", "label": "CODE_INJECTION", "role": "vuln", "code": "// delayed action scheduler\napp.post('/schedule', (req, res) => {\n  const delay = Number(req.body.delay) || 0;\n  setTimeout(req.body.action, delay);\n  res.json({ ok: true });\n});\n// background jobs"}
{"pair_id": "train-CODE_INJECTION-10", "set": "train", "vuln_type": "CODE_INJECTION", "subtype": "plain", "id": "train-CODE_INJECTION-10-s", "label": "SAFE", "role": "safe", "code": "// delayed action scheduler\nconst ACTIONS = {\n  refresh: () => cache.refresh(),\n  reindex: () => search.reindex(),\n};\napp.post('/schedule', (req, res) => {\n  const action = ACTIONS[req.body.action];\n  if (!action) return res.sendStatus(400);\n  setTimeout(action, Number(req.body.delay) || 0);\n  res.json({ ok: true });\n});\n// background jobs"}
{"pair_id": "train-PATH_TRAVERSAL-06", "set": "train", "vuln_type": "PATH_TRAVERSAL", "subtype": "plain", "id": "train-PATH_TRAVERSAL-06-v", "label": "PATH_TRAVERSAL", "role": "vuln", "code": "// attachment download\napp.get('/attachment', (req, res) => {\n  const name = req.query.file;\n  res.send(fs.readFileSync(path.join('/srv/attachments', name)));\n});\n// requires auth"}
{"pair_id": "train-PATH_TRAVERSAL-06", "set": "train", "vuln_type": "PATH_TRAVERSAL", "subtype": "plain", "id": "train-PATH_TRAVERSAL-06-s", "label": "SAFE", "role": "safe", "code": "// attachment download\nconst ROOT = '/srv/attachments';\napp.get('/attachment', (req, res) => {\n  const full = path.resolve(ROOT, path.basename(String(req.query.file)));\n  if (!full.startsWith(ROOT + path.sep)) return res.sendStatus(403);\n  res.send(fs.readFileSync(full));\n});\n// requires auth"}
{"pair_id": "train-PATH_TRAVERSAL-07", "set": "train", "vuln_type": "PATH_TRAVERSAL", "subtype": "insufficient", "id": "train-PATH_TRAVERSAL-07-v", "label": "PATH_TRAVERSAL", "role": "vuln", "code": "// asset loader\napp.get('/assets', (req, res) => {\n  const p = req.query.p;\n  if (!p.startsWith('public/')) return res.sendStatus(400);\n  res.sendFile(path.join('/srv', p));\n});\n// static assets"}
{"pair_id": "train-PATH_TRAVERSAL-07", "set": "train", "vuln_type": "PATH_TRAVERSAL", "subtype": "insufficient", "id": "train-PATH_TRAVERSAL-07-s", "label": "SAFE", "role": "safe", "code": "// asset loader\nconst ROOT = '/srv/public';\napp.get('/assets', (req, res) => {\n  const full = path.resolve(ROOT, String(req.query.p));\n  if (!full.startsWith(ROOT + path.sep)) return res.sendStatus(400);\n  res.sendFile(full);\n});\n// static assets"}
{"pair_id": "train-PATH_TRAVERSAL-08", "set": "train", "vuln_type": "PATH_TRAVERSAL", "subtype": "plain", "id": "train-PATH_TRAVERSAL-08-v", "label": "PATH_TRAVERSAL", "role": "vuln", "code": "// template renderer\napp.get('/tpl', (req, res) => {\n  res.sendFile(req.query.name, { root: '/srv/templates' });\n});\n// template preview"}
{"pair_id": "train-PATH_TRAVERSAL-08", "set": "train", "vuln_type": "PATH_TRAVERSAL", "subtype": "plain", "id": "train-PATH_TRAVERSAL-08-s", "label": "SAFE", "role": "safe", "code": "// template renderer\napp.get('/tpl', (req, res) => {\n  const name = path.basename(String(req.query.name));\n  if (!/\\.html$/.test(name)) return res.sendStatus(400);\n  res.sendFile(name, { root: '/srv/templates' });\n});\n// template preview"}
{"pair_id": "train-PATH_TRAVERSAL-09", "set": "train", "vuln_type": "PATH_TRAVERSAL", "subtype": "plain", "id": "train-PATH_TRAVERSAL-09-v", "label": "PATH_TRAVERSAL", "role": "vuln", "code": "// media stream\napp.get('/media/:name', (req, res) => {\n  const stream = fs.createReadStream('/srv/media/' + req.params.name);\n  stream.pipe(res);\n});\n// supports video"}
{"pair_id": "train-PATH_TRAVERSAL-09", "set": "train", "vuln_type": "PATH_TRAVERSAL", "subtype": "plain", "id": "train-PATH_TRAVERSAL-09-s", "label": "SAFE", "role": "safe", "code": "// media stream\napp.get('/media/:name', (req, res) => {\n  const name = path.basename(req.params.name);\n  const full = path.join('/srv/media', name);\n  if (!full.startsWith('/srv/media/')) return res.sendStatus(400);\n  fs.createReadStream(full).pipe(res);\n});\n// supports video"}
{"pair_id": "train-PATH_TRAVERSAL-10", "set": "train", "vuln_type": "PATH_TRAVERSAL", "subtype": "insufficient", "id": "train-PATH_TRAVERSAL-10-v", "label": "PATH_TRAVERSAL", "role": "vuln", "code": "// legacy file fetch\napp.get('/legacy/fetch', (req, res) => {\n  const encoded = encodeURIComponent(req.query.path);\n  res.send(fs.readFileSync('/srv/legacy/' + encoded));\n});\n// deprecated"}
{"pair_id": "train-PATH_TRAVERSAL-10", "set": "train", "vuln_type": "PATH_TRAVERSAL", "subtype": "insufficient", "id": "train-PATH_TRAVERSAL-10-s", "label": "SAFE", "role": "safe", "code": "// legacy file fetch\nconst ROOT = '/srv/legacy';\napp.get('/legacy/fetch', (req, res) => {\n  const full = path.resolve(ROOT, path.basename(String(req.query.path)));\n  if (!full.startsWith(ROOT + path.sep)) return res.sendStatus(403);\n  res.send(fs.readFileSync(full));\n});\n// deprecated"}
{"pair_id": "train-SSRF-06", "set": "train", "vuln_type": "SSRF", "subtype": "plain", "id": "train-SSRF-06-v", "label": "SSRF", "role": "vuln", "code": "// image proxy endpoint\napp.get('/img', async (req, res) => {\n  const r = await fetch(req.query.src);\n  const buf = Buffer.from(await r.arrayBuffer());\n  res.type('image/png').send(buf);\n});\n// public endpoint"}
{"pair_id": "train-SSRF-06", "set": "train", "vuln_type": "SSRF", "subtype": "plain", "id": "train-SSRF-06-s", "label": "SAFE", "role": "safe", "code": "// image proxy endpoint\nconst ALLOWED = new Set(['images.example.com', 'cdn.example.com']);\napp.get('/img', async (req, res) => {\n  const u = new URL(String(req.query.src));\n  if (u.protocol !== 'https:' || !ALLOWED.has(u.hostname)) return res.sendStatus(400);\n  const r = await fetch(u.href, { redirect: 'error' });\n  const buf = Buffer.from(await r.arrayBuffer());\n  res.type('image/png').send(buf);\n});\n// public endpoint"}
{"pair_id": "train-SSRF-07", "set": "train", "vuln_type": "SSRF", "subtype": "insufficient", "id": "train-SSRF-07-v", "label": "SSRF", "role": "vuln", "code": "// link preview\napp.post('/preview', async (req, res) => {\n  const u = new URL(String(req.body.url));\n  if (u.hostname === 'localhost' || u.hostname === '127.0.0.1') return res.sendStatus(400);\n  const r = await axios.get(u.href);\n  res.json({ title: r.data.match(/<title>([^<]+)/)?.[1] || '' });\n});\n// used in chat"}
{"pair_id": "train-SSRF-07", "set": "train", "vuln_type": "SSRF", "subtype": "insufficient", "id": "train-SSRF-07-s", "label": "SAFE", "role": "safe", "code": "// link preview\nconst PRIVATE = /^(10\\.|127\\.|169\\.254\\.|172\\.(1[6-9]|2\\d|3[01])\\.|192\\.168\\.|\\[::1\\]|localhost)/i;\napp.post('/preview', async (req, res) => {\n  const u = new URL(String(req.body.url));\n  if (u.protocol !== 'https:') return res.sendStatus(400);\n  const ip = (await dns.promises.lookup(u.hostname)).address;\n  if (PRIVATE.test(ip) || PRIVATE.test(u.hostname)) return res.sendStatus(400);\n  const r = await axios.get(u.href, { maxRedirects: 0 });\n  res.json({ title: r.data.match(/<title>([^<]+)/)?.[1] || '' });\n});\n// used in chat"}
{"pair_id": "train-SSRF-08", "set": "train", "vuln_type": "SSRF", "subtype": "plain", "id": "train-SSRF-08-v", "label": "SSRF", "role": "vuln", "code": "// webhook dispatcher\napp.post('/hooks/dispatch', async (req, res) => {\n  await axios.post(req.body.url, req.body.payload);\n  res.json({ ok: true });\n});\n// internal service"}
{"pair_id": "train-SSRF-08", "set": "train", "vuln_type": "SSRF", "subtype": "plain", "id": "train-SSRF-08-s", "label": "SAFE", "role": "safe", "code": "// webhook dispatcher\nconst REGISTERED = new Set(['hooks.example.com', 'events.example.com']);\napp.post('/hooks/dispatch', async (req, res) => {\n  const u = new URL(String(req.body.url));\n  if (u.protocol !== 'https:' || !REGISTERED.has(u.hostname)) return res.sendStatus(400);\n  await axios.post(u.href, req.body.payload, { maxRedirects: 0 });\n  res.json({ ok: true });\n});\n// internal service"}
{"pair_id": "train-SSRF-09", "set": "train", "vuln_type": "SSRF", "subtype": "plain", "id": "train-SSRF-09-v", "label": "SSRF", "role": "vuln", "code": "// rss reader\napp.get('/rss', (req, res) => {\n  const url = req.query.url;\n  http.get(url, (upstream) => upstream.pipe(res));\n});\n// user subscriptions"}
{"pair_id": "train-SSRF-09", "set": "train", "vuln_type": "SSRF", "subtype": "plain", "id": "train-SSRF-09-s", "label": "SAFE", "role": "safe", "code": "// rss reader\nconst FEEDS = ['news.example.com', 'blog.example.com'];\napp.get('/rss', (req, res) => {\n  const u = new URL(String(req.query.url));\n  if (u.protocol !== 'https:' || !FEEDS.includes(u.hostname)) return res.sendStatus(400);\n  https.get(u.href, (upstream) => upstream.pipe(res));\n});\n// user subscriptions"}
{"pair_id": "train-SSRF-10", "set": "train", "vuln_type": "SSRF", "subtype": "insufficient", "id": "train-SSRF-10-v", "label": "SSRF", "role": "vuln", "code": "// partner integration\napp.post('/partner', async (req, res) => {\n  const u = new URL(String(req.body.endpoint));\n  if (!u.hostname.endsWith('example.com')) return res.sendStatus(400);\n  const r = await axios.get(u.href);\n  res.json(r.data);\n});\n// partner API"}
{"pair_id": "train-SSRF-10", "set": "train", "vuln_type": "SSRF", "subtype": "insufficient", "id": "train-SSRF-10-s", "label": "SAFE", "role": "safe", "code": "// partner integration\nconst PARTNER_HOSTS = new Set(['api.partner1.example.com', 'api.partner2.example.com']);\napp.post('/partner', async (req, res) => {\n  const u = new URL(String(req.body.endpoint));\n  if (u.protocol !== 'https:' || !PARTNER_HOSTS.has(u.hostname)) return res.sendStatus(400);\n  const r = await axios.get(u.href, { maxRedirects: 0 });\n  res.json(r.data);\n});\n// partner API"}
{"pair_id": "train-PROTO_POLLUTION-06", "set": "train", "vuln_type": "PROTO_POLLUTION", "subtype": "plain", "id": "train-PROTO_POLLUTION-06-v", "label": "PROTO_POLLUTION", "role": "vuln", "code": "// query parameter normalizer\nfunction normalize(qs) {\n  const out = {};\n  for (const k in qs) {\n    out[k] = qs[k];\n  }\n  return out;\n}\n// used on every request"}
{"pair_id": "train-PROTO_POLLUTION-06", "set": "train", "vuln_type": "PROTO_POLLUTION", "subtype": "plain", "id": "train-PROTO_POLLUTION-06-s", "label": "SAFE", "role": "safe", "code": "// query parameter normalizer\nfunction normalize(qs) {\n  const out = Object.create(null);\n  for (const k of Object.keys(qs)) {\n    if (k === '__proto__' || k === 'constructor' || k === 'prototype') continue;\n    out[k] = qs[k];\n  }\n  return out;\n}\n// used on every request"}
{"pair_id": "train-PROTO_POLLUTION-07", "set": "train", "vuln_type": "PROTO_POLLUTION", "subtype": "insufficient", "id": "train-PROTO_POLLUTION-07-v", "label": "PROTO_POLLUTION", "role": "vuln", "code": "// patch applier\nfunction apply(base, patch) {\n  for (const k of Object.keys(patch)) {\n    if (k === '__proto__') continue;\n    if (patch[k] && typeof patch[k] === 'object') {\n      base[k] = base[k] || {};\n      apply(base[k], patch[k]);\n    } else {\n      base[k] = patch[k];\n    }\n  }\n  return base;\n}\n// preferences update"}
{"pair_id": "train-PROTO_POLLUTION-07", "set": "train", "vuln_type": "PROTO_POLLUTION", "subtype": "insufficient", "id": "train-PROTO_POLLUTION-07-s", "label": "SAFE", "role": "safe", "code": "// patch applier\nconst FORBIDDEN = new Set(['__proto__', 'constructor', 'prototype']);\nfunction apply(base, patch) {\n  for (const k of Object.keys(patch)) {\n    if (FORBIDDEN.has(k)) continue;\n    if (patch[k] && typeof patch[k] === 'object') {\n      base[k] = base[k] || {};\n      apply(base[k], patch[k]);\n    } else {\n      base[k] = patch[k];\n    }\n  }\n  return base;\n}\n// preferences update"}
{"pair_id": "train-PROTO_POLLUTION-08", "set": "train", "vuln_type": "PROTO_POLLUTION", "subtype": "plain", "id": "train-PROTO_POLLUTION-08-v", "label": "PROTO_POLLUTION", "role": "vuln", "code": "// settings merge from query params\napp.get('/settings', (req, res) => {\n  const merged = Object.assign({}, defaults, req.query);\n  res.json(merged);\n});\n// legacy settings API"}
{"pair_id": "train-PROTO_POLLUTION-08", "set": "train", "vuln_type": "PROTO_POLLUTION", "subtype": "plain", "id": "train-PROTO_POLLUTION-08-s", "label": "SAFE", "role": "safe", "code": "// settings merge from query params\nconst KEYS = ['theme', 'lang', 'tz'];\napp.get('/settings', (req, res) => {\n  const merged = { ...defaults };\n  for (const k of KEYS) if (req.query[k] !== undefined) merged[k] = req.query[k];\n  res.json(merged);\n});\n// legacy settings API"}
{"pair_id": "train-PROTO_POLLUTION-09", "set": "train", "vuln_type": "PROTO_POLLUTION", "subtype": "plain", "id": "train-PROTO_POLLUTION-09-v", "label": "PROTO_POLLUTION", "role": "vuln", "code": "// form data binder\nfunction bind(form, data) {\n  Object.keys(data).forEach((k) => {\n    if (typeof data[k] === 'object' && data[k] !== null) {\n      form[k] = form[k] || {};\n      bind(form[k], data[k]);\n    } else {\n      form[k] = data[k];\n    }\n  });\n}\n// contact form handler"}
{"pair_id": "train-PROTO_POLLUTION-09", "set": "train", "vuln_type": "PROTO_POLLUTION", "subtype": "plain", "id": "train-PROTO_POLLUTION-09-s", "label": "SAFE", "role": "safe", "code": "// form data binder\nfunction bind(form, data) {\n  Object.keys(data).forEach((k) => {\n    if (k === '__proto__' || k === 'constructor' || k === 'prototype') return;\n    if (typeof data[k] === 'object' && data[k] !== null) {\n      form[k] = form[k] || {};\n      bind(form[k], data[k]);\n    } else {\n      form[k] = data[k];\n    }\n  });\n}\n// contact form handler"}
{"pair_id": "train-PROTO_POLLUTION-10", "set": "train", "vuln_type": "PROTO_POLLUTION", "subtype": "insufficient", "id": "train-PROTO_POLLUTION-10-v", "label": "PROTO_POLLUTION", "role": "vuln", "code": "// filter builder\nfunction buildFilter(fields) {\n  const f = {};\n  for (const k of Object.keys(fields)) {\n    if (!Object.prototype.hasOwnProperty.call(fields, k)) continue;\n    f[k] = fields[k];\n  }\n  return f;\n}\n// search endpoint"}
{"pair_id": "train-PROTO_POLLUTION-10", "set": "train", "vuln_type": "PROTO_POLLUTION", "subtype": "insufficient", "id": "train-PROTO_POLLUTION-10-s", "label": "SAFE", "role": "safe", "code": "// filter builder\nconst ALLOWED = new Set(['name', 'status', 'owner']);\nfunction buildFilter(fields) {\n  const f = Object.create(null);\n  for (const k of Object.keys(fields)) {\n    if (!ALLOWED.has(k)) continue;\n    f[k] = String(fields[k]);\n  }\n  return f;\n}\n// search endpoint"}
{"pair_id": "train-OPEN_REDIRECT-06", "set": "train", "vuln_type": "OPEN_REDIRECT", "subtype": "plain", "id": "train-OPEN_REDIRECT-06-v", "label": "OPEN_REDIRECT", "role": "vuln", "code": "// auth callback\napp.get('/auth/done', (req, res) => {\n  res.redirect(req.query.return || '/');\n});\n// after login"}
{"pair_id": "train-OPEN_REDIRECT-06", "set": "train", "vuln_type": "OPEN_REDIRECT", "subtype": "plain", "id": "train-OPEN_REDIRECT-06-s", "label": "SAFE", "role": "safe", "code": "// auth callback\nconst DESTINATIONS = { home: '/', profile: '/profile', settings: '/settings' };\napp.get('/auth/done', (req, res) => {\n  const dest = Object.prototype.hasOwnProperty.call(DESTINATIONS, req.query.return) ? DESTINATIONS[req.query.return] : '/';\n  res.redirect(dest);\n});\n// after login"}
{"pair_id": "train-OPEN_REDIRECT-07", "set": "train", "vuln_type": "OPEN_REDIRECT", "subtype": "insufficient", "id": "train-OPEN_REDIRECT-07-v", "label": "OPEN_REDIRECT", "role": "vuln", "code": "// external link handler\napp.get('/out', (req, res) => {\n  const to = req.query.to || '/';\n  if (to.startsWith('http://') || to.startsWith('https://')) return res.redirect('/');\n  res.redirect(to);\n});\n// used by the app"}
{"pair_id": "train-OPEN_REDIRECT-07", "set": "train", "vuln_type": "OPEN_REDIRECT", "subtype": "insufficient", "id": "train-OPEN_REDIRECT-07-s", "label": "SAFE", "role": "safe", "code": "// external link handler\napp.get('/out', (req, res) => {\n  const to = String(req.query.to || '/');\n  if (!to.startsWith('/') || to.startsWith('//') || to.startsWith('/\\\\')) return res.redirect('/');\n  res.redirect(to);\n});\n// used by the app"}
{"pair_id": "train-OPEN_REDIRECT-08", "set": "train", "vuln_type": "OPEN_REDIRECT", "subtype": "plain", "id": "train-OPEN_REDIRECT-08-v", "label": "OPEN_REDIRECT", "role": "vuln", "code": "// oauth callback\napp.get('/oauth/cb', (req, res) => {\n  exchangeCode(req.query.code);\n  res.redirect(req.query.state);\n});\n// used by the oauth client"}
{"pair_id": "train-OPEN_REDIRECT-08", "set": "train", "vuln_type": "OPEN_REDIRECT", "subtype": "plain", "id": "train-OPEN_REDIRECT-08-s", "label": "SAFE", "role": "safe", "code": "// oauth callback\napp.get('/oauth/cb', (req, res) => {\n  const state = verifySignedState(req.query.state);\n  if (!state || !state.redirect) return res.sendStatus(400);\n  exchangeCode(req.query.code);\n  res.redirect(state.redirect);\n});\n// used by the oauth client"}
{"pair_id": "train-OPEN_REDIRECT-09", "set": "train", "vuln_type": "OPEN_REDIRECT", "subtype": "plain", "id": "train-OPEN_REDIRECT-09-v", "label": "OPEN_REDIRECT", "role": "vuln", "code": "// locale switcher\napp.get('/locale/:code', (req, res) => {\n  res.cookie('lang', req.params.code);\n  res.location(req.query.back || '/');\n  res.status(302).end();\n});\n// language picker"}
{"pair_id": "train-OPEN_REDIRECT-09", "set": "train", "vuln_type": "OPEN_REDIRECT", "subtype": "plain", "id": "train-OPEN_REDIRECT-09-s", "label": "SAFE", "role": "safe", "code": "// locale switcher\napp.get('/locale/:code', (req, res) => {\n  res.cookie('lang', req.params.code);\n  const back = String(req.query.back || '/');\n  const safe = (back.startsWith('/') && !back.startsWith('//') && !back.startsWith('/\\\\')) ? back : '/';\n  res.location(safe);\n  res.status(302).end();\n});\n// language picker"}
{"pair_id": "train-OPEN_REDIRECT-10", "set": "train", "vuln_type": "OPEN_REDIRECT", "subtype": "insufficient", "id": "train-OPEN_REDIRECT-10-v", "label": "OPEN_REDIRECT", "role": "vuln", "code": "// magic login link\napp.get('/magic/verify', (req, res) => {\n  verifyToken(req.query.token);\n  const target = req.query.next;\n  if (target.includes('example.com')) return res.redirect(target);\n  res.redirect('/');\n});\n// passwordless login"}
{"pair_id": "train-OPEN_REDIRECT-10", "set": "train", "vuln_type": "OPEN_REDIRECT", "subtype": "insufficient", "id": "train-OPEN_REDIRECT-10-s", "label": "SAFE", "role": "safe", "code": "// magic login link\napp.get('/magic/verify', (req, res) => {\n  verifyToken(req.query.token);\n  let u;\n  try { u = new URL(String(req.query.next)); } catch (e) { return res.redirect('/'); }\n  if (u.protocol === 'https:' && u.hostname === 'app.example.com') return res.redirect(u.href);\n  res.redirect('/');\n});\n// passwordless login"}
{"pair_id": "train-AUTHZ-06", "set": "train", "vuln_type": "AUTHZ", "subtype": "plain", "id": "train-AUTHZ-06-v", "label": "AUTHZ", "role": "vuln", "code": "// user profile read\napp.get('/api/users/:id', requireLogin, async (req, res) => {\n  const user = await User.findById(req.params.id).select('name email');\n  res.json(user);\n});\n// public API"}
{"pair_id": "train-AUTHZ-06", "set": "train", "vuln_type": "AUTHZ", "subtype": "plain", "id": "train-AUTHZ-06-s", "label": "SAFE", "role": "safe", "code": "// user profile read\napp.get('/api/users/:id', requireLogin, async (req, res) => {\n  if (req.params.id !== req.user.id && req.user.role !== 'admin') return res.sendStatus(403);\n  const user = await User.findById(req.params.id).select('name email');\n  res.json(user);\n});\n// public API"}
{"pair_id": "train-AUTHZ-07", "set": "train", "vuln_type": "AUTHZ", "subtype": "insufficient", "id": "train-AUTHZ-07-v", "label": "AUTHZ", "role": "vuln", "code": "// invoice detail\napp.get('/api/invoices/:id', requireLogin, async (req, res) => {\n  const inv = await Invoice.findById(req.params.id);\n  if (!inv) return res.sendStatus(404);\n  res.json(inv);\n});\n// invoicing API"}
{"pair_id": "train-AUTHZ-07", "set": "train", "vuln_type": "AUTHZ", "subtype": "insufficient", "id": "train-AUTHZ-07-s", "label": "SAFE", "role": "safe", "code": "// invoice detail\napp.get('/api/invoices/:id', requireLogin, async (req, res) => {\n  const inv = await Invoice.findOne({ _id: req.params.id, ownerId: req.user.id });\n  if (!inv) return res.sendStatus(404);\n  res.json(inv);\n});\n// invoicing API"}
{"pair_id": "train-AUTHZ-08", "set": "train", "vuln_type": "AUTHZ", "subtype": "plain", "id": "train-AUTHZ-08-v", "label": "AUTHZ", "role": "vuln", "code": "// registration with admin flag\napp.post('/api/users', async (req, res) => {\n  const user = await User.create(req.body);\n  res.status(201).json(user);\n});\n// registration endpoint"}
{"pair_id": "train-AUTHZ-08", "set": "train", "vuln_type": "AUTHZ", "subtype": "plain", "id": "train-AUTHZ-08-s", "label": "SAFE", "role": "safe", "code": "// registration with admin flag\napp.post('/api/users', async (req, res) => {\n  const { email, name, password } = req.body;\n  const user = await User.create({ email, name, password, role: 'user' });\n  res.status(201).json(user);\n});\n// registration endpoint"}
{"pair_id": "train-AUTHZ-09", "set": "train", "vuln_type": "AUTHZ", "subtype": "plain", "id": "train-AUTHZ-09-v", "label": "AUTHZ", "role": "vuln", "code": "// comment removal\napp.delete('/api/comments/:id', requireLogin, async (req, res) => {\n  await Comment.findByIdAndDelete(req.params.id);\n  res.sendStatus(204);\n});\n// moderation API"}
{"pair_id": "train-AUTHZ-09", "set": "train", "vuln_type": "AUTHZ", "subtype": "plain", "id": "train-AUTHZ-09-s", "label": "SAFE", "role": "safe", "code": "// comment removal\napp.delete('/api/comments/:id', requireLogin, async (req, res) => {\n  const c = await Comment.findById(req.params.id);\n  if (!c) return res.sendStatus(404);\n  if (c.authorId.toString() !== req.user.id && req.user.role !== 'moderator') return res.sendStatus(403);\n  await c.deleteOne();\n  res.sendStatus(204);\n});\n// moderation API"}
{"pair_id": "train-AUTHZ-10", "set": "train", "vuln_type": "AUTHZ", "subtype": "insufficient", "id": "train-AUTHZ-10-v", "label": "AUTHZ", "role": "vuln", "code": "// admin action guard\nfunction requireRole(req, res, next) {\n  if (req.headers['x-role'] === 'admin') return next();\n  return res.sendStatus(403);\n}\n\napp.get('/admin/stats', requireRole, (req, res) => res.json(getStats()));\n// admin panel"}
{"pair_id": "train-AUTHZ-10", "set": "train", "vuln_type": "AUTHZ", "subtype": "insufficient", "id": "train-AUTHZ-10-s", "label": "SAFE", "role": "safe", "code": "// admin action guard\nfunction requireRole(req, res, next) {\n  if (req.user && req.user.role === 'admin') return next();\n  return res.sendStatus(403);\n}\n\napp.get('/admin/stats', requireLogin, requireRole, (req, res) => res.json(getStats()));\n// admin panel"}
{"pair_id": "train-WEAK_CRYPTO-06", "set": "train", "vuln_type": "WEAK_CRYPTO", "subtype": "plain", "id": "train-WEAK_CRYPTO-06-v", "label": "WEAK_CRYPTO", "role": "vuln", "code": "// checksum helper\nfunction checksum(data) {\n  return crypto.createHash('sha1').update(data).digest('hex');\n}\n// used on upload"}
{"pair_id": "train-WEAK_CRYPTO-06", "set": "train", "vuln_type": "WEAK_CRYPTO", "subtype": "plain", "id": "train-WEAK_CRYPTO-06-s", "label": "SAFE", "role": "safe", "code": "// checksum helper\nfunction checksum(data) {\n  return crypto.createHash('sha256').update(data).digest('hex');\n}\n// used on upload"}
{"pair_id": "train-WEAK_CRYPTO-07", "set": "train", "vuln_type": "WEAK_CRYPTO", "subtype": "insufficient", "id": "train-WEAK_CRYPTO-07-v", "label": "WEAK_CRYPTO", "role": "vuln", "code": "// password store\nfunction storePassword(pw) {\n  const salt = 'app-salt-v1';\n  return crypto.createHash('sha256').update(salt + pw).digest('hex');\n}\n// used on signup"}
{"pair_id": "train-WEAK_CRYPTO-07", "set": "train", "vuln_type": "WEAK_CRYPTO", "subtype": "insufficient", "id": "train-WEAK_CRYPTO-07-s", "label": "SAFE", "role": "safe", "code": "// password store\nfunction storePassword(pw) {\n  const salt = crypto.randomBytes(16);\n  const hash = crypto.scryptSync(pw, salt, 64);\n  return salt.toString('hex') + ':' + hash.toString('hex');\n}\n// used on signup"}
{"pair_id": "train-WEAK_CRYPTO-08", "set": "train", "vuln_type": "WEAK_CRYPTO", "subtype": "plain", "id": "train-WEAK_CRYPTO-08-v", "label": "WEAK_CRYPTO", "role": "vuln", "code": "// field encryption\nfunction encryptField(plain, key) {\n  const cipher = crypto.createCipheriv('aes-256-ecb', key, null);\n  return Buffer.concat([cipher.update(plain), cipher.final()]).toString('base64');\n}\n// used on PII fields"}
{"pair_id": "train-WEAK_CRYPTO-08", "set": "train", "vuln_type": "WEAK_CRYPTO", "subtype": "plain", "id": "train-WEAK_CRYPTO-08-s", "label": "SAFE", "role": "safe", "code": "// field encryption\nfunction encryptField(plain, key) {\n  const iv = crypto.randomBytes(12);\n  const cipher = crypto.createCipheriv('aes-256-gcm', key, iv);\n  const ct = Buffer.concat([cipher.update(plain), cipher.final()]);\n  return Buffer.concat([iv, cipher.getAuthTag(), ct]).toString('base64');\n}\n// used on PII fields"}
{"pair_id": "train-WEAK_CRYPTO-09", "set": "train", "vuln_type": "WEAK_CRYPTO", "subtype": "insufficient", "id": "train-WEAK_CRYPTO-09-v", "label": "WEAK_CRYPTO", "role": "vuln", "code": "// record encryption\nfunction encryptRecord(plain, key) {\n  const iv = Buffer.alloc(16, 0);\n  const cipher = crypto.createCipheriv('aes-256-cbc', key, iv);\n  return Buffer.concat([cipher.update(plain), cipher.final()]).toString('hex');\n}\n// used on backups"}
{"pair_id": "train-WEAK_CRYPTO-09", "set": "train", "vuln_type": "WEAK_CRYPTO", "subtype": "insufficient", "id": "train-WEAK_CRYPTO-09-s", "label": "SAFE", "role": "safe", "code": "// record encryption\nfunction encryptRecord(plain, key) {\n  const iv = crypto.randomBytes(16);\n  const cipher = crypto.createCipheriv('aes-256-cbc', key, iv);\n  const ct = Buffer.concat([cipher.update(plain), cipher.final()]);\n  return Buffer.concat([iv, ct]).toString('hex');\n}\n// used on backups"}
{"pair_id": "train-WEAK_CRYPTO-10", "set": "train", "vuln_type": "WEAK_CRYPTO", "subtype": "plain", "id": "train-WEAK_CRYPTO-10-v", "label": "WEAK_CRYPTO", "role": "vuln", "code": "// API token generator\nfunction newToken() {\n  return Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2);\n}\n// issued on login"}
{"pair_id": "train-WEAK_CRYPTO-10", "set": "train", "vuln_type": "WEAK_CRYPTO", "subtype": "plain", "id": "train-WEAK_CRYPTO-10-s", "label": "SAFE", "role": "safe", "code": "// API token generator\nfunction newToken() {\n  return crypto.randomBytes(32).toString('base64url');\n}\n// issued on login"}
