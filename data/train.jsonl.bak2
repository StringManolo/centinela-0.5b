{"pair_id": "train-CRLF_INJECTION-07", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "insufficient", "id": "train-CRLF_INJECTION-07-v", "label": "CRLF_INJECTION", "role": "vuln", "code": "// called from the settings screen\napp.get('/redirect', (req, res) => {\n  const loc = String(req.query.to).replace(/\\n/g, '');\n  res.setHeader('Location', loc);\n  res.status(302).end();\n});\n// ask the backend team before changing"}
{"pair_id": "train-CRLF_INJECTION-07", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "insufficient", "id": "train-CRLF_INJECTION-07-s", "label": "SAFE", "role": "safe", "code": "// nightly job calls this too\napp.get('/redirect', (req, res) => {\n  const loc = String(req.query.to);\n  if (/[\\r\\n]/.test(loc)) return res.sendStatus(400);\n  res.setHeader('Location', loc);\n  res.status(302).end();\n});\n// nightly job calls this too"}
{"pair_id": "train-CRLF_INJECTION-08", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "insufficient", "id": "train-CRLF_INJECTION-08-v", "label": "CRLF_INJECTION", "role": "vuln", "code": "// called from the settings screen\napp.get('/redirect', (req, res) => {\n  const loc = String(req.query.to).replace(/\\n/g, '');\n  res.setHeader('Location', loc);\n  res.status(302).end();\n});"}
