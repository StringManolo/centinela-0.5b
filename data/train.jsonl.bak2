{"pair_id": "train-LDAP_INJECTION-10", "set": "train", "vuln_type": "LDAP_INJECTION", "subtype": "insufficient", "id": "train-LDAP_INJECTION-10-v", "label": "LDAP_INJECTION", "role": "vuln", "code": "// covered by the integration tests\n// documented in the wiki\napp.post('/lookup', (req, res) => {\n  const sanitized = String(req.body.uid).replace(/[*()\\\\]/g, '');\n  const filter = '(uid=' + sanitized + ')';\n  ldapClient.search('dc=example,dc=com', { filter }, (err, r) => r.on('end', () => res.json({ done: true })));\n});\n// also used by the dashboard\n// feature flag lives in the config"}
