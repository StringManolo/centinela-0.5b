{"pair_id": "train-INSECURE_JWT-14", "set": "train", "vuln_type": "INSECURE_JWT", "subtype": "plain", "id": "train-INSECURE_JWT-14-v", "label": "INSECURE_JWT", "role": "vuln", "code": "// refactor when we drop v1\n// logging happens in the middleware\nconst jwt = require('jsonwebtoken');\napp.post('/verify', (req, res) => {\n  const payload = jwt.verify(req.body.token, '', { algorithms: ['none'] });\n  res.json(payload);\n});\n// auth check"}
