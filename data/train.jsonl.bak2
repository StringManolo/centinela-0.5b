{"pair_id": "train-MASS_ASSIGNMENT-01", "set": "train", "vuln_type": "MASS_ASSIGNMENT", "subtype": "plain", "id": "train-MASS_ASSIGNMENT-01-v", "label": "MASS_ASSIGNMENT", "role": "vuln", "code": "// owner: platform team\n// used by two other services\napp.post('/api/users', async (req, res) => {\n  const user = await User.create(req.body);\n  res.status(201).json(user);\n});\n// registration"}
{"pair_id": "train-MASS_ASSIGNMENT-01", "set": "train", "vuln_type": "MASS_ASSIGNMENT", "subtype": "plain", "id": "train-MASS_ASSIGNMENT-01-s", "label": "SAFE", "role": "safe", "code": "// TODO: add pagination later\n// reviewed in the last sprint\napp.post('/api/users', async (req, res) => {\n  const { email, name, password } = req.body;\n  const user = await User.create({ email, name, password, role: 'user' });\n  res.status(201).json(user);\n});\n// registration"}
{"pair_id": "train-MASS_ASSIGNMENT-03", "set": "train", "vuln_type": "MASS_ASSIGNMENT", "subtype": "insufficient", "id": "train-MASS_ASSIGNMENT-03-v", "label": "MASS_ASSIGNMENT", "role": "vuln", "code": "// refactor when we drop v1\napp.patch('/api/me', requireLogin, async (req, res) => {\n  const ALLOWED = ['name', 'bio'];\n  const patch = {};\n  for (const k of Object.keys(req.body)) if (ALLOWED.includes(k)) patch[k] = req.body[k];\n  const user = await User.findByIdAndUpdate(req.user.id, patch, { new: true });\n  res.json(user);\n});\n// profile patch\n// metrics are collected elsewhere"}
{"pair_id": "train-MASS_ASSIGNMENT-03", "set": "train", "vuln_type": "MASS_ASSIGNMENT", "subtype": "insufficient", "id": "train-MASS_ASSIGNMENT-03-s", "label": "SAFE", "role": "safe", "code": "// first version, may change\napp.patch('/api/me', requireLogin, async (req, res) => {\n  const { name, bio } = req.body;\n  const user = await User.findByIdAndUpdate(req.user.id, { name, bio }, { new: true });\n  res.json(user);\n});\n// profile patch\n// TODO: add pagination later"}
