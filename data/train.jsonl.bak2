{"pair_id": "train-CSRF-05", "set": "train", "vuln_type": "CSRF", "subtype": "plain", "id": "train-CSRF-05-v", "label": "CSRF", "role": "vuln", "code": "// metrics are collected elsewhere\napp.delete('/api/posts/:id', requireLogin, async (req, res) => {\n  await Post.findByIdAndDelete(req.params.id);\n  res.sendStatus(204);\n});"}
{"pair_id": "train-CSRF-05", "set": "train", "vuln_type": "CSRF", "subtype": "plain", "id": "train-CSRF-05-s", "label": "SAFE", "role": "safe", "code": "// called from the settings screen\napp.delete('/api/posts/:id', requireLogin, csrfProtection, async (req, res) => {\n  if (req.headers['x-csrf-token'] !== req.session.csrf) return res.sendStatus(403);\n  await Post.findByIdAndDelete(req.params.id);\n  res.sendStatus(204);\n});"}
