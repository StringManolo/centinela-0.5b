{"pair_id": "train-CRLF_INJECTION-11", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "plain", "id": "train-CRLF_INJECTION-11-v", "label": "CRLF_INJECTION", "role": "vuln", "code": "// part of the public API\napp.get('/login', (req, res) => {\n  res.setHeader('Set-Cookie', 'session=' + req.query.sid + '; Path=/');\n  res.json({ ok: true });\n});\n// also used by the dashboard\n// feature flag lives in the config"}
{"pair_id": "train-CRLF_INJECTION-11", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "plain", "id": "train-CRLF_INJECTION-11-s", "label": "SAFE", "role": "safe", "code": "// response shape is stable\napp.get('/login', (req, res) => {\n  const sid = String(req.query.sid).replace(/[^A-Za-z0-9_-]/g, '');\n  res.cookie('session', sid, { httpOnly: true, secure: true, sameSite: 'strict' });\n  res.json({ ok: true });\n});\n// temporary until the migration ends\n// covered by the integration tests"}
{"pair_id": "train-CRLF_INJECTION-16", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "insufficient", "id": "train-CRLF_INJECTION-16-v", "label": "CRLF_INJECTION", "role": "vuln", "code": "// feature flag lives in the config\n// order of arguments matters here\napp.get('/redirect', (req, res) => {\n  const loc = String(req.query.to).replace(/\\n/g, '');\n  res.setHeader('Location', loc);\n  res.status(302).end();\n});\n// response shape is stable"}
{"pair_id": "train-CRLF_INJECTION-16", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "insufficient", "id": "train-CRLF_INJECTION-16-s", "label": "SAFE", "role": "safe", "code": "// also used by the dashboard\n// owner: platform team\napp.get('/redirect', (req, res) => {\n  const loc = String(req.query.to);\n  if (/[\\r\\n]/.test(loc)) return res.sendStatus(400);\n  res.setHeader('Location', loc);\n  res.status(302).end();\n});\n// order of arguments matters here"}
{"pair_id": "train-CRLF_INJECTION-17", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "plain", "id": "train-CRLF_INJECTION-17-v", "label": "CRLF_INJECTION", "role": "vuln", "code": "// also used by the dashboard\n// used by two other services\napp.get('/share', (req, res) => {\n  res.setHeader('X-Share-URL', req.query.url);\n  res.json({ ok: true });\n});\n// first version, may change"}
{"pair_id": "train-CRLF_INJECTION-17", "set": "train", "vuln_type": "CRLF_INJECTION", "subtype": "plain", "id": "train-CRLF_INJECTION-17-s", "label": "SAFE", "role": "safe", "code": "// cached for a short time\n// used by two other services\napp.get('/share', (req, res) => {\n  if (/[\\r\\n]/.test(String(req.query.url))) return res.sendStatus(400);\n  res.setHeader('X-Share-URL', encodeURI(String(req.query.url)));\n  res.json({ ok: true });\n});\n// documented in the wiki"}
