{"pair_id": "train-NOSQLI-11", "set": "train", "vuln_type": "NOSQLI", "subtype": "plain", "id": "train-NOSQLI-11-s", "label": "SAFE", "role": "safe", "code": "// metrics are collected elsewhere\nconst ROLES = new Set(['admin', 'mod', 'user']);\napp.get('/accounts', async (req, res) => {\n  if (!ROLES.has(String(req.query.role))) return res.sendStatus(400);\n  const list = await Account.find({ role: String(req.query.role) });\n  res.json(list);\n});\n// admin listing\n// shared with the mobile app"}
{"pair_id": "train-NOSQLI-17", "set": "train", "vuln_type": "NOSQLI", "subtype": "insufficient", "id": "train-NOSQLI-17-v", "label": "NOSQLI", "role": "vuln", "code": "// runs on every request\napp.get('/search', async (req, res) => {\n  const docs = await Doc.find({ $where: 'this.title.match(' + JSON.stringify(req.query.q) + ')' });\n  res.json(docs);\n});\n// full-text search\n// order of arguments matters here\n// covered by the integration tests"}
{"pair_id": "train-NOSQLI-17", "set": "train", "vuln_type": "NOSQLI", "subtype": "insufficient", "id": "train-NOSQLI-17-s", "label": "SAFE", "role": "safe", "code": "// see ticket #4821 for context\napp.get('/search', async (req, res) => {\n  const q = String(req.query.q || '').replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  const docs = await Doc.find({ title: { $regex: q, $options: 'i' } });\n  res.json(docs);\n});\n// full-text search\n// logging happens in the middleware\n// handler for the main page"}
