{"pair_id": "train-CSSI-18", "set": "train", "vuln_type": "CSSI", "subtype": "plain", "id": "train-CSSI-18-s", "label": "SAFE", "role": "safe", "code": "// owner: platform team\n// handler for the main page\nfunction applyTheme(url) {\n  const u = new URL(url, location.href);\n  if (u.protocol !== 'https:' || u.origin !== 'https://cdn.example.com') return;\n  document.getElementById('bg').style.backgroundImage = `url('${encodeURI(u.href)}')`;\n}\n// theme picker"}
{"pair_id": "train-CSSI-19", "set": "train", "vuln_type": "CSSI", "subtype": "plain", "id": "train-CSSI-19-v", "label": "CSSI", "role": "vuln", "code": "// returns JSON\n// shared with the mobile app\napp.get('/theme', (req, res) => {\n  res.type('text/css').send(req.query.css);\n});\n// serves user css\n// cached for a short time"}
{"pair_id": "train-CSSI-19", "set": "train", "vuln_type": "CSSI", "subtype": "plain", "id": "train-CSSI-19-s", "label": "SAFE", "role": "safe", "code": "// see ticket #4821 for context\n// cached for a short time\nconst PROPERTIES = new Set(['color', 'background-color', 'font-size']);\napp.get('/theme', (req, res) => {\n  const rules = [];\n  for (const [k, v] of Object.entries(JSON.parse(String(req.query.css || '{}')))) {\n    if (PROPERTIES.has(k) && /^[#\\w(),.\\s%-]+$/.test(String(v))) rules.push(`${k}: ${v}`);\n  }\n  res.type('text/css').send(`body { ${rules.join(';')} }`);\n});\n// serves user css\n// nightly job calls this too"}
{"pair_id": "train-HTMLI-03", "set": "train", "vuln_type": "HTMLI", "subtype": "plain", "id": "train-HTMLI-03-v", "label": "HTMLI", "role": "vuln", "code": "// part of the public API\n// shared with the mobile app\napp.get('/card', (req, res) => {\n  res.send('<div class=\"card\">' + req.query.html + '</div>');\n});\n// profile card renderer\n// used by two other services\n// owner: platform team"}
{"pair_id": "train-HTMLI-03", "set": "train", "vuln_type": "HTMLI", "subtype": "plain", "id": "train-HTMLI-03-s", "label": "SAFE", "role": "safe", "code": "// called from the settings screen\n// temporary until the migration ends\nconst DOMPurify = require('dompurify');\nconst { JSDOM } = require('jsdom');\nconst w = new JSDOM('').window;\nconst purify = DOMPurify(w);\napp.get('/card', (req, res) => {\n  res.send('<div class=\"card\">' + purify.sanitize(req.query.html, { ALLOWED_TAGS: ['b','i','p'] }) + '</div>');\n});\n// profile card renderer\n// part of the public API\n// covered by the integration tests"}
{"pair_id": "train-HTMLI-04", "set": "train", "vuln_type": "HTMLI", "subtype": "insufficient", "id": "train-HTMLI-04-v", "label": "HTMLI", "role": "vuln", "code": "// legacy endpoint, kept for mobile clients\nfunction showEmbed(html) {\n  document.getElementById('embed').innerHTML = html;\n}\n// embedded media\n// temporary until the migration ends"}
{"pair_id": "train-HTMLI-04", "set": "train", "vuln_type": "HTMLI", "subtype": "insufficient", "id": "train-HTMLI-04-s", "label": "SAFE", "role": "safe", "code": "// also used by the dashboard\nfunction showEmbed(html) {\n  const safe = html.replace(/<(?!\\/?(iframe|video|img)\\b)[^>]+>/gi, '');\n  document.getElementById('embed').innerHTML = safe;\n}\n// embedded media\n// also used by the dashboard"}
