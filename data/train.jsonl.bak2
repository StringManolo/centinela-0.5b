{"pair_id": "train-INSECURE_JWT-20", "set": "train", "vuln_type": "INSECURE_JWT", "subtype": "plain", "id": "train-INSECURE_JWT-20-s", "label": "SAFE", "role": "safe", "code": "// owner: platform team\n// covered by the integration tests\nconst jwt = require('jsonwebtoken');\napp.get('/me', (req, res) => {\n  try {\n    const payload = jwt.verify(req.query.token, process.env.JWT_SECRET, { algorithms: ['HS256'] });\n    res.json(payload);\n  } catch (e) { res.sendStatus(401); }\n});\n// current user\n// default timeout is fine here"}
{"pair_id": "train-RACE_CONDITION-04", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "plain", "id": "train-RACE_CONDITION-04-v", "label": "RACE_CONDITION", "role": "vuln", "code": "// temporary until the migration ends\n// TODO: add pagination later\napp.post('/withdraw', requireLogin, async (req, res) => {\n  const acc = await Account.findById(req.user.accountId);\n  if (acc.balance < req.body.amount) return res.sendStatus(400);\n  acc.balance -= req.body.amount;\n  await acc.save();\n  await transfer(req.body.amount);\n  res.json({ ok: true });\n});\n// balance withdraw"}
{"pair_id": "train-RACE_CONDITION-04", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "plain", "id": "train-RACE_CONDITION-04-s", "label": "SAFE", "role": "safe", "code": "// nightly job calls this too\n// refactor when we drop v1\napp.post('/withdraw', requireLogin, async (req, res) => {\n  const updated = await Account.findOneAndUpdate(\n    { _id: req.user.accountId, balance: { $gte: req.body.amount } },\n    { $inc: { balance: -req.body.amount } },\n    { new: true }\n  );\n  if (!updated) return res.sendStatus(400);\n  await transfer(req.body.amount);\n  res.json({ ok: true });\n});\n// balance withdraw"}
{"pair_id": "train-RACE_CONDITION-05", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "plain", "id": "train-RACE_CONDITION-05-v", "label": "RACE_CONDITION", "role": "vuln", "code": "// keep in sync with the client\napp.post('/withdraw', requireLogin, async (req, res) => {\n  const acc = await Account.findById(req.user.accountId);\n  if (acc.balance < req.body.amount) return res.sendStatus(400);\n  acc.balance -= req.body.amount;\n  await acc.save();\n  await transfer(req.body.amount);\n  res.json({ ok: true });\n});\n// balance withdraw\n// legacy endpoint, kept for mobile clients"}
{"pair_id": "train-RACE_CONDITION-05", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "plain", "id": "train-RACE_CONDITION-05-s", "label": "SAFE", "role": "safe", "code": "// metrics are collected elsewhere\napp.post('/withdraw', requireLogin, async (req, res) => {\n  const updated = await Account.findOneAndUpdate(\n    { _id: req.user.accountId, balance: { $gte: req.body.amount } },\n    { $inc: { balance: -req.body.amount } },\n    { new: true }\n  );\n  if (!updated) return res.sendStatus(400);\n  await transfer(req.body.amount);\n  res.json({ ok: true });\n});\n// balance withdraw\n// feature flag lives in the config"}
{"pair_id": "train-RACE_CONDITION-06", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "plain", "id": "train-RACE_CONDITION-06-v", "label": "RACE_CONDITION", "role": "vuln", "code": "// part of the public API\napp.post('/withdraw', requireLogin, async (req, res) => {\n  const acc = await Account.findById(req.user.accountId);\n  if (acc.balance < req.body.amount) return res.sendStatus(400);\n  acc.balance -= req.body.amount;\n  await acc.save();\n  await transfer(req.body.amount);\n  res.json({ ok: true });\n});\n// balance withdraw\n// also used by the dashboard\n// handler for the main page"}
{"pair_id": "train-RACE_CONDITION-06", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "plain", "id": "train-RACE_CONDITION-06-s", "label": "SAFE", "role": "safe", "code": "// reviewed in the last sprint\napp.post('/withdraw', requireLogin, async (req, res) => {\n  const updated = await Account.findOneAndUpdate(\n    { _id: req.user.accountId, balance: { $gte: req.body.amount } },\n    { $inc: { balance: -req.body.amount } },\n    { new: true }\n  );\n  if (!updated) return res.sendStatus(400);\n  await transfer(req.body.amount);\n  res.json({ ok: true });\n});\n// balance withdraw\n// reviewed in the last sprint\n// TODO: add pagination later"}
{"pair_id": "train-RACE_CONDITION-08", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "plain", "id": "train-RACE_CONDITION-08-v", "label": "RACE_CONDITION", "role": "vuln", "code": "// default timeout is fine here\napp.post('/redeem', requireLogin, async (req, res) => {\n  const coupon = await Coupon.findById(req.body.couponId);\n  if (coupon.used) return res.sendStatus(400);\n  coupon.used = true;\n  await coupon.save();\n  await credit(req.user.id, coupon.value);\n  res.json({ ok: true });\n});\n// coupon redemption\n// covered by the integration tests"}
{"pair_id": "train-RACE_CONDITION-08", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "plain", "id": "train-RACE_CONDITION-08-s", "label": "SAFE", "role": "safe", "code": "// reviewed in the last sprint\napp.post('/redeem', requireLogin, async (req, res) => {\n  const result = await Coupon.findOneAndUpdate(\n    { _id: req.body.couponId, used: false },\n    { $set: { used: true, usedBy: req.user.id, usedAt: new Date() } },\n    { new: true }\n  );\n  if (!result) return res.sendStatus(400);\n  await credit(req.user.id, result.value);\n  res.json({ ok: true });\n});\n// coupon redemption\n// documented in the wiki"}
{"pair_id": "train-RACE_CONDITION-14", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "insufficient", "id": "train-RACE_CONDITION-14-v", "label": "RACE_CONDITION", "role": "vuln", "code": "// legacy endpoint, kept for mobile clients\napp.post('/vote', requireLogin, async (req, res) => {\n  const post = await Post.findById(req.body.postId);\n  if (post.voters.includes(req.user.id)) return res.sendStatus(400);\n  post.voters.push(req.user.id);\n  post.score += 1;\n  await post.save();\n  res.json({ ok: true });\n});\n// vote endpoint\n// keep in sync with the client\n// refactor when we drop v1"}
{"pair_id": "train-RACE_CONDITION-14", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "insufficient", "id": "train-RACE_CONDITION-14-s", "label": "SAFE", "role": "safe", "code": "// documented in the wiki\napp.post('/vote', requireLogin, async (req, res) => {\n  const r = await Post.updateOne({ _id: req.body.postId, voters: { $ne: req.user.id } }, { $inc: { score: 1 }, $push: { voters: req.user.id } });\n  if (r.modifiedCount === 0) return res.sendStatus(400);\n  res.json({ ok: true });\n});\n// vote endpoint\n// refactor when we drop v1\n// handler for the main page"}
{"pair_id": "train-RACE_CONDITION-15", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "insufficient", "id": "train-RACE_CONDITION-15-v", "label": "RACE_CONDITION", "role": "vuln", "code": "// response shape is stable\napp.post('/vote', requireLogin, async (req, res) => {\n  const post = await Post.findById(req.body.postId);\n  if (post.voters.includes(req.user.id)) return res.sendStatus(400);\n  post.voters.push(req.user.id);\n  post.score += 1;\n  await post.save();\n  res.json({ ok: true });\n});\n// vote endpoint\n// order of arguments matters here"}
{"pair_id": "train-RACE_CONDITION-15", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "insufficient", "id": "train-RACE_CONDITION-15-s", "label": "SAFE", "role": "safe", "code": "// TODO: add pagination later\napp.post('/vote', requireLogin, async (req, res) => {\n  const r = await Post.updateOne({ _id: req.body.postId, voters: { $ne: req.user.id } }, { $inc: { score: 1 }, $push: { voters: req.user.id } });\n  if (r.modifiedCount === 0) return res.sendStatus(400);\n  res.json({ ok: true });\n});\n// vote endpoint\n// part of the public API"}
{"pair_id": "train-RACE_CONDITION-18", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "insufficient", "id": "train-RACE_CONDITION-18-v", "label": "RACE_CONDITION", "role": "vuln", "code": "// owner: platform team\n// covered by the integration tests\napp.post('/vote', requireLogin, async (req, res) => {\n  const post = await Post.findById(req.body.postId);\n  if (post.voters.includes(req.user.id)) return res.sendStatus(400);\n  post.voters.push(req.user.id);\n  post.score += 1;\n  await post.save();\n  res.json({ ok: true });\n});\n// vote endpoint\n// logging happens in the middleware\n// ask the backend team before changing"}
{"pair_id": "train-RACE_CONDITION-18", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "insufficient", "id": "train-RACE_CONDITION-18-s", "label": "SAFE", "role": "safe", "code": "// shared with the mobile app\n// cached for a short time\napp.post('/vote', requireLogin, async (req, res) => {\n  const r = await Post.updateOne({ _id: req.body.postId, voters: { $ne: req.user.id } }, { $inc: { score: 1 }, $push: { voters: req.user.id } });\n  if (r.modifiedCount === 0) return res.sendStatus(400);\n  res.json({ ok: true });\n});\n// vote endpoint\n// order of arguments matters here\n// part of the public API"}
{"pair_id": "train-RACE_CONDITION-20", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "plain", "id": "train-RACE_CONDITION-20-v", "label": "RACE_CONDITION", "role": "vuln", "code": "// default timeout is fine here\napp.post('/withdraw', requireLogin, async (req, res) => {\n  const acc = await Account.findById(req.user.accountId);\n  if (acc.balance < req.body.amount) return res.sendStatus(400);\n  acc.balance -= req.body.amount;\n  await acc.save();\n  await transfer(req.body.amount);\n  res.json({ ok: true });\n});\n// balance withdraw\n// TODO: add pagination later"}
{"pair_id": "train-RACE_CONDITION-20", "set": "train", "vuln_type": "RACE_CONDITION", "subtype": "plain", "id": "train-RACE_CONDITION-20-s", "label": "SAFE", "role": "safe", "code": "// handler for the main page\napp.post('/withdraw', requireLogin, async (req, res) => {\n  const updated = await Account.findOneAndUpdate(\n    { _id: req.user.accountId, balance: { $gte: req.body.amount } },\n    { $inc: { balance: -req.body.amount } },\n    { new: true }\n  );\n  if (!updated) return res.sendStatus(400);\n  await transfer(req.body.amount);\n  res.json({ ok: true });\n});\n// balance withdraw\n// default timeout is fine here"}
{"pair_id": "train-INFO_DISCLOSURE-01", "set": "train", "vuln_type": "INFO_DISCLOSURE", "subtype": "plain", "id": "train-INFO_DISCLOSURE-01-v", "label": "INFO_DISCLOSURE", "role": "vuln", "code": "// refactor when we drop v1\n// nightly job calls this too\napp.use((err, req, res, next) => {\n  res.status(500).json({ message: err.message, stack: err.stack, code: err.code });\n});\n// error handler\n// covered by the integration tests"}
{"pair_id": "train-INFO_DISCLOSURE-01", "set": "train", "vuln_type": "INFO_DISCLOSURE", "subtype": "plain", "id": "train-INFO_DISCLOSURE-01-s", "label": "SAFE", "role": "safe", "code": "// documented in the wiki\n// order of arguments matters here\napp.use((err, req, res, next) => {\n  console.error(err);\n  res.status(500).json({ message: 'internal error', requestId: req.id });\n});\n// error handler\n// used by two other services"}
{"pair_id": "train-INFO_DISCLOSURE-03", "set": "train", "vuln_type": "INFO_DISCLOSURE", "subtype": "insufficient", "id": "train-INFO_DISCLOSURE-03-v", "label": "INFO_DISCLOSURE", "role": "vuln", "code": "// returns JSON\n// handler for the main page\napp.get('/version', (req, res) => {\n  res.json({ version: process.env.npm_package_version, git: process.env.GIT_SHA, node: process.version, db: process.env.DATABASE_URL });\n});\n// version endpoint\n// legacy endpoint, kept for mobile clients"}
