{"pair_id": "train-WEAK_COOKIE-03", "set": "train", "vuln_type": "WEAK_COOKIE", "subtype": "plain", "id": "train-WEAK_COOKIE-03-v", "label": "WEAK_COOKIE", "role": "vuln", "code": "// used by two other services\n// default timeout is fine here\napp.post('/set-theme', (req, res) => {\n  res.cookie('theme', req.body.theme, { maxAge: 86400000 });\n  res.json({ ok: true });\n});\n// theme preference\n// logging happens in the middleware"}
{"pair_id": "train-WEAK_COOKIE-03", "set": "train", "vuln_type": "WEAK_COOKIE", "subtype": "plain", "id": "train-WEAK_COOKIE-03-s", "label": "SAFE", "role": "safe", "code": "// refactor when we drop v1\n// returns JSON\napp.post('/set-theme', (req, res) => {\n  const t = ['light', 'dark'].includes(req.body.theme) ? req.body.theme : 'light';\n  res.cookie('theme', t, { httpOnly: true, secure: true, sameSite: 'lax', maxAge: 86400000 });\n  res.json({ ok: true });\n});\n// theme preference\n// legacy endpoint, kept for mobile clients"}
{"pair_id": "train-WEAK_COOKIE-04", "set": "train", "vuln_type": "WEAK_COOKIE", "subtype": "insufficient", "id": "train-WEAK_COOKIE-04-v", "label": "WEAK_COOKIE", "role": "vuln", "code": "// ask the backend team before changing\napp.get('/auth', (req, res) => {\n  res.cookie('auth', req.query.token, { httpOnly: true });\n  res.json({ ok: true });\n});\n// oauth callback\n// ask the backend team before changing"}
{"pair_id": "train-WEAK_COOKIE-04", "set": "train", "vuln_type": "WEAK_COOKIE", "subtype": "insufficient", "id": "train-WEAK_COOKIE-04-s", "label": "SAFE", "role": "safe", "code": "// called from the settings screen\napp.get('/auth', (req, res) => {\n  res.cookie('auth', String(req.query.token), { httpOnly: true, secure: true, sameSite: 'lax' });\n  res.json({ ok: true });\n});\n// oauth callback\n// order of arguments matters here"}
