{"pair_id": "train-XXE-02", "set": "train", "vuln_type": "XXE", "subtype": "plain", "id": "train-XXE-02-v", "label": "XXE", "role": "vuln", "code": "// order of arguments matters here\nconst libxml = require('libxmljs');\napp.post('/parse', (req, res) => {\n  const doc = libxml.parseXml(req.body.xml, { resolveEntities: true });\n  res.json({ root: doc.root().name() });\n});\n// order of arguments matters here"}
